# ===== 模型 Key（二选一必填；主力 P0 预检后定稿）=====
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# ===== 过渡期 LLM：SenseNova 公测免费（每模型每 5h 1500 次）=====
# 注意：2026 年起主推 Token Plan（token.sensenova.cn，OpenAI 兼容）；
# 新平台 Key 打老端点 api.sensenova.cn 会 403，模型名也换成 sensenova-* 一代
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# ===== 模型选型（有默认值，可覆盖）=====
MODEL_MAIN=deepseek-chat
MODEL_FALLBACK=glm-4-flash
# PLANNER_MODE: llm(真实拆解) | template(确定性兜底，离线测试用)
PLANNER_MODE=llm
# SYNTH_MODE: llm(带引用报告+流式) | template(模板兜底，离线测试用)
SYNTH_MODE=llm

# ===== 工具与降级开关（PLAN D-5：评测对照与兜底共用）=====
# PROVIDER_MODE: fake(离线) | direct(直连) | mcp(协议)
PROVIDER_MODE=fake
# WEB_PROVIDER: deepseek | zhipu | tavily | none
WEB_PROVIDER=deepseek
# 智谱独立 web_search API 引擎档位（注意：该接口收费，未充值返回 1113）
ZHIPU_SEARCH_ENGINE=search_std

# ===== 老仓库连接（D6/D7：MCP stdio 取证 + HTTP 兜底）=====
# MCP Server A（web）启动命令：解释器用老仓库的 ai_study 环境（mcp SDK 装在那里）
# MCP_WEB_CMD=/opt/anaconda3/envs/ai_study/bin/python /绝对路径/智谱项目/mcp/mcp_web_server.py
MCP_WEB_CMD=
# MCP Server B（kb，D7）启动命令；demo 演示想让检索指向脱敏语料而非私人
# 笔记，同时设置下面的 KB_CHROMA_DIR（由本进程环境继承给 Server B）
# MCP_KB_CMD=/opt/anaconda3/envs/ai_study/bin/python /绝对路径/智谱项目/mcp/mcp_kb_server.py
MCP_KB_CMD=
# 只影响 MCP Server B 的检索目标目录（老仓库 config 读取；不设=检索真私有库）
# KB_CHROMA_DIR=/绝对路径/智谱项目/data/chroma_demo
KB_CHROMA_DIR=
# DirectProvider.kb 兜底直连老仓库 REST（PROVIDER_MODE=direct 时用）
KB_API_BASE=http://127.0.0.1:8000
# 必须与老仓库 .env 的 APP_AUTH_TOKEN 一致（老仓库没配令牌则留空）
KB_API_TOKEN=

# ===== Agent 化开关（v2.3/v2.4）=====
# AGENT_MODE: research（StateGraph 流水线，可评测）| react（ReAct 自主循环，LLM 驱动工具调用）
AGENT_MODE=research
AGENT_MAX_STEPS=10

# ===== Agent 化开关（v2.3）=====
# REFLECT_MODE: llm（验证后 LLM 反思→learnings+查询改写，循环真转）| off（原查询重试）
REFLECT_MODE=llm
# 跨 run 记忆：研究沉淀落 data/memory/（gitignored），下次研究召回注入
MEMORY_ENABLED=1

# ===== UI 运行形态（D8：三端共用事件契约）=====
# UI_MODE: gateway(默认，Streamlit 作 SSE 客户端读网关) | inline(进程内直调图，砍线兜底)
UI_MODE=gateway
# FastAPI 网关地址（先 uvicorn api.main:app --port 8000 再开 Streamlit）
GATEWAY_URL=http://127.0.0.1:8000

# ===== Agent 行为参数 =====
MAX_ROUNDS=3
BREADTH=3
EVIDENCE_CHAR_BUDGET=12000
# 注入强过滤：strict（默认）=命中注入特征的证据隔离出综合 prompt + 报告命中行
# 剥除（ReAct 路径观察文本同步脱敏）；report=只告警不拦截（评审 P2-9 原语义，对照用）
INJECTION_FILTER=strict

# ===== Langfuse 追踪（云端免费档；D9 接入）=====
# 开关与 Key 分离：填了 Key 不等于追踪，显式置 1 才上报（离线测试默认关）
LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
