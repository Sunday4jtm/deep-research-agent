# ===== 模型 Key（二选一必填；主力 P0 预检后定稿）=====
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# ===== 过渡期 LLM：SenseNova 公测免费（每模型每 5h 1500 次）=====
# 注意：2026 年起主推 Token Plan（token.sensenova.cn，OpenAI 兼容）；
# 新平台 Key 打老端点 api.sensenova.cn 会 403，模型名也换成 sensenova-* 一代
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# ===== 模型选型（有默认值，可覆盖）=====
MODEL_MAIN=deepseek-chat
MODEL_FALLBACK=glm-4-flash
# PLANNER_MODE: llm(真实拆解) | template(确定性兜底，离线测试用)
PLANNER_MODE=llm
# SYNTH_MODE: llm(带引用报告+流式) | template(模板兜底，离线测试用)
SYNTH_MODE=llm

# ===== 工具与降级开关（PLAN D-5：评测对照与兜底共用）=====
# PROVIDER_MODE: fake(离线) | direct(直连) | mcp(协议)
PROVIDER_MODE=fake
# WEB_PROVIDER: deepseek | zhipu | tavily | none
WEB_PROVIDER=deepseek
# 智谱独立 web_search API 引擎档位（注意：该接口收费，未充值返回 1113）
ZHIPU_SEARCH_ENGINE=search_std

# ===== Agent 行为参数 =====
MAX_ROUNDS=3
BREADTH=3
EVIDENCE_CHAR_BUDGET=12000

# ===== Langfuse 追踪（云端免费档；P3 接入时填写）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
